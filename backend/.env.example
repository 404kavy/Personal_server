# Personal Server Environment Configuration
PROJECT_NAME="Personal Activity Server & Assistant"
HOST="127.0.0.1"
PORT=8000

# Ollama local instance
OLLAMA_BASE_URL="http://127.0.0.1:11434"
DEFAULT_MODEL="llama3.2:3b"

# Database: SQLite (default) or PostgreSQL
DATABASE_URL="sqlite:///./personal_server.db"
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/personal_server"

# Secret token for telemetry collectors (X-Local-Token header)
LOCAL_AUTH_TOKEN="dev-secret-token-change-in-env"

